PORT=3000

# ---- Supabase (recommended) ----
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public/publishable (anon) key — safe for browser. Do NOT push to the repo.
SUPABASE_PUBLISHABLE_KEY=
# Service-role key — server only. NEVER commit or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Legacy direct-Postgres mode (alternate) ----
# Connection string (pooler) with password. Used only if Supabase is not configured.
DATABASE_URL=
DATABASE_SSL=false
