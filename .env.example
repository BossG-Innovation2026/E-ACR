PORT=3000
# Postgres connection string. For Supabase use the "Session pooler" (port 5432) or
# "Transaction pooler" (6543) URI from Project Settings -> Database -> Connection string.
# Example (pooler):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# If omitted, the app falls back to a local JSON file store (dev only).
DATABASE_URL=
# Set to true when SSL is required and not already indicated by sslmode=require.
DATABASE_SSL=false
